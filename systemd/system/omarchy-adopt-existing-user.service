[Unit]
Description=Adopt an existing user after a cross-distro Omarchy bootc switch
Documentation=https://github.com/joshyorko/omarchy-bootc
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/omarchy/omarchy-adopt-existing-user.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
